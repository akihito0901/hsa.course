# ══ サーバー用の秘密キー（Vercel の環境変数に設定する） ══
# Vercel → プロジェクト → Settings → Environment Variables に、下記を1つずつ登録します。
# このファイル自体には値を書かず、控えとしてだけ使ってください（.gitignore 済み）。

# Supabase（Project Settings → API）
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=（service_role の秘密キー。絶対に公開しない）

# Stripe（Developers → API keys / Products）
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
STRIPE_PRICE_ID=price_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# 公開サイトのURL（決済後の戻り先などに使用）
SITE_URL=https://hsa-course.vercel.app
